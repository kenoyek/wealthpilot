{
  "name": "wealthpilot",
  "version": "1.0.0",
  "description": "Private personal finance for irregular income",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/*.test.ts",
    "test:db": "node --env-file=.env.local --test tests/database.test.mjs tests/planning.test.mjs",
    "test:e2e": "playwright test",
    "db:start": "bash scripts/prepare-local-db.sh && node scripts/supabase.mjs start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,storage-api,postgres-meta",
    "db:reset": "node scripts/supabase.mjs db reset",
    "env:local": "node scripts/local-env.mjs",
    "tools:install": "bash scripts/install-supabase.sh",
    "format:check": "prettier --check app components lib tests scripts \"*.ts\" \"*.mjs\" \"*.json\"",
    "check:production": "node scripts/check-production-env.mjs",
    "neon:render": "node scripts/render-neon-migrations.mjs",
    "test:neon-contract": "node --test tests/neon-contract.test.mjs",
    "android:tools": "python3 scripts/install-android-tools.py",
    "android:sdk": "node scripts/android.mjs sdk",
    "android:build": "node scripts/android.mjs assembleDebug",
    "android:lint": "node scripts/android.mjs lint",
    "android:bundle": "node scripts/android.mjs bundleRelease",
    "android:test": "node scripts/android.mjs testDebugUnitTest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenoyek/wealthpilot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kenoyek/wealthpilot/issues"
  },
  "homepage": "https://github.com/kenoyek/wealthpilot#readme",
  "dependencies": {
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/neon-js": "^0.9.0-beta",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@neondatabase/auth": {
      "zod": "$zod"
    },
    "@neondatabase/neon-js": {
      "zod": "$zod"
    }
  }
}
