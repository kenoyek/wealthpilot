<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="28sp" android:textColor="@color/brand"
            android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/launch_intro" android:textSize="16sp" />
        <Button android:id="@+id/open_app" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:minHeight="48dp" android:text="@string/open_app" />
        <Button android:id="@+id/open_browser" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/open_browser" />
        <TextView android:id="@+id/launch_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/ready" android:textSize="16sp"
            android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/site_address" android:textIsSelectable="true" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
