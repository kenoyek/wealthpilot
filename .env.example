# Vercel production uses Neon, not the local fixture above.
# Set these directly in Vercel; do not deploy the local Supabase bindings.
# WEALTHPILOT_PRIVATE_RELEASE=true
# WEALTHPILOT_OWNER_EMAIL=
# NEON_AUTH_BASE_URL=
